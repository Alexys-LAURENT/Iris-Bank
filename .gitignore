.env
.env.*
!.env.example
!.env.exemple

# Local configuration and runtime data
**/.env
**/.env.*
!**/.env.example
!**/.env.exemple
**/node_modules/
**/.next/
**/.gradle/
**/*.sqlite
**/*.sqlite3
